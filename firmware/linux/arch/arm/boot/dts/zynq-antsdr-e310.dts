// ANTSDR E310 Micro-USB bring-up target, not Ettus E310 or ANTSDR E310V2.
/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include "zynq-7000.dtsi"
/ {
    model = "MicroPhase ANTSDR E310 Micro-USB (experimental UHD)";
    compatible = "microphase,antsdr-e310", "xlnx,zynq-7000";
    aliases { serial0 = &uart1; ethernet0 = &gem0; ethernet1 = &nixge0; };
    chosen { stdout-path = "serial0:115200n8"; };
    // Upper 512 MiB is used exclusively by the FPGA TX deep FIFO.
    memory@0 { device_type = "memory"; reg = <0 0x20000000>; };
};
&uart1 { status = "okay"; };
&sdhci0 { status = "okay"; };
&gpio0 { status = "okay"; };
&clkc { ps-clk-frequency = <33333333>; fclk-enable = <1>; };
&gem0 {
    status = "okay";
    phy-mode = "rgmii-id";
    // Verify address against the board's MDIO scan before deploying this DTB.
    phy-handle = <&phy0>;
    phy0: ethernet-phy@0 {
        reg = <0>;
        reset-gpios = <&gpio0 46 GPIO_ACTIVE_LOW>;
        reset-assert-us = <10000>;
        reset-deassert-us = <10000>;
    };
};
&fpga_full {
    nixge0: ethernet@40000000 {
        compatible = "ni,xge-enet-2.00";
        reg = <0x40000000 0x8000>;
        clocks = <&clkc 15>;
        clock-names = "bus_clk";
        interrupts = <0 29 4>, <0 30 4>;
        interrupt-names = "rx", "tx";
        interrupt-parent = <&intc>;
        phy-mode = "gmii";
        status = "okay";
        fixed-link { speed = <1000>; full-duplex; };
    };
};
