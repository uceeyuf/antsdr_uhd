diff --git a/lib/examples/e310_si_combine.h b/lib/examples/e310_si_combine.h
new file mode 100644
index 0000000..5b2d3cd
--- /dev/null
+++ b/lib/examples/e310_si_combine.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Bounded experimental SIB1 soft combining for the diagnostic receiver.
+#ifndef E310_SI_COMBINE_H
+#define E310_SI_COMBINE_H
+#include <stdlib.h>
+#include <string.h>
+#include "srsran/srsran.h"
+
+typedef struct {
+  srsran_softbuffer_rx_t soft;
+  uint32_t group, tbs, previous_tti;
+  bool have_previous;
+  int16_t* llr;
+} e310_si_combiner;
+
+static int e310_si_combiner_init(e310_si_combiner* q, uint32_t nof_prb)
+{
+  memset(q, 0, sizeof(*q));
+  if (srsran_softbuffer_rx_init(&q->soft, nof_prb)) return -1;
+  // Maximum QPSK bits in a normal-CP LTE subframe.
+  q->llr = srsran_vec_i16_malloc(100 * 12 * 14 * 2);
+  if (!q->llr) { srsran_softbuffer_rx_free(&q->soft); return -1; }
+  return 0;
+}
+
+// Returns 1 for a fresh CRC pass, 0 for CRC failure, -1 for unsupported input.
+// The normal independent decode has already populated descrambled PDSCH LLRs.
+static int e310_si_combiner_run(e310_si_combiner* q, srsran_ue_dl_t* dl,
+                               srsran_pdsch_cfg_t* cfg, uint32_t tti, uint8_t* payload,
+                               bool combine, unsigned divisor)
+{
+  const srsran_ra_tb_t* tb = &cfg->grant.tb[0];
+  if (dl->cell.frame_type != SRSRAN_FDD || dl->cell.cp != SRSRAN_CP_NORM ||
+      cfg->rnti != SRSRAN_SIRNTI || tti >= 10240 || tti % 20 != 5 ||
+      !tb->enabled || cfg->grant.tb[1].enabled || tb->cw_idx != 0 ||
+      tb->mod != SRSRAN_MOD_QPSK || tb->tbs <= 0 || tb->tbs > 16000 * 8 ||
+      tb->nof_bits == 0 || tb->nof_bits > 100 * 12 * 14 * 2 ||
+      dl->pdsch.llr_is_8bit || divisor == 0 || divisor > 256) {
+    q->have_previous = false;
+    return -1;
+  }
+  uint32_t group = tti / 80;
+  // Do not carry LLRs across an 80 ms boundary, missing occasions or TBS changes.
+  if (!combine || !q->have_previous || q->group != group || q->tbs != (uint32_t)tb->tbs ||
+      (q->previous_tti + 20) % 10240 != tti) {
+    srsran_softbuffer_rx_reset_tbs(&q->soft, tb->tbs);
+  }
+  q->group = group;
+  q->tbs = tb->tbs;
+  q->previous_tti = tti;
+  q->have_previous = true;
+  // Force a fresh turbo/CRC computation; a cached successful block is not a new decode.
+  srsran_softbuffer_rx_reset_cb_crc(&q->soft, q->soft.max_cb);
+  const int16_t* input = dl->pdsch.e[0];
+  for (uint32_t bit = 0; bit < tb->nof_bits; bit++) q->llr[bit] = input[bit] / (int)divisor;
+  srsran_pdsch_cfg_t combined_cfg = *cfg;
+  combined_cfg.softbuffers.rx[0] = &q->soft;
+  return srsran_dlsch_decode2(&dl->pdsch.dl_sch, &combined_cfg, q->llr, payload, 0,
+                              cfg->grant.nof_layers) == SRSRAN_SUCCESS;
+}
+
+static void e310_si_combiner_free(e310_si_combiner* q)
+{
+  srsran_softbuffer_rx_free(&q->soft);
+  free(q->llr);
+}
+#endif
diff --git a/lib/examples/e310_replay_sib1.c b/lib/examples/e310_replay_sib1.c
new file mode 100644
index 0000000..94018e2
--- /dev/null
+++ b/lib/examples/e310_replay_sib1.c
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+// Replay synchronized SIB1 snapshots from the patched pdsch_ue receiver.
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "srsran/srsran.h"
+#include "e310_si_combine.h"
+
+int main(int argc, char** argv)
+{
+  if (argc < 3 || argc > 5) {
+    fprintf(stderr, "Usage: %s capture.bin {wiener|interpolate|average} [sync_error:0|1] [turbo_iterations:1..16]\n", argv[0]);
+    return 2;
+  }
+  if (strcmp(argv[2], "wiener") && strcmp(argv[2], "interpolate") && strcmp(argv[2], "average")) return 2;
+  bool sync_error = true;
+  if (argc >= 4) {
+    if (strcmp(argv[3], "0") && strcmp(argv[3], "1")) return 2;
+    sync_error = !strcmp(argv[3], "1");
+  }
+  unsigned iterations = 0;
+  if (argc == 5) {
+    char* end = NULL;
+    unsigned long value = strtoul(argv[4], &end, 10);
+    if (!*argv[4] || *end || value == 0 || value > 16) return 2;
+    iterations = value;
+  }
+  const char* correction = getenv("REPLAY_CFO_HZ");
+  float fixed_cfo_hz = 0;
+  if (correction && strcmp(correction, "cp")) {
+    char* end = NULL;
+    fixed_cfo_hz = strtof(correction, &end);
+    if (!*correction || *end || strspn(correction, "0123456789eE+.-") != strlen(correction) || !isfinite(fixed_cfo_hz) || fabsf(fixed_cfo_hz) > 7500) return 2;
+  }
+  const char* boolean_names[] = {"REPLAY_COMBINE", "REPLAY_CSI", "REPLAY_MMSE"};
+  for (unsigned i = 0; i < 3; i++) {
+    const char* value = getenv(boolean_names[i]);
+    if (value && strcmp(value, "0") && strcmp(value, "1")) return 2;
+  }
+  const char* divisor_str = getenv("REPLAY_LLR_DIVISOR");
+  unsigned divisor = 4;
+  if (divisor_str) {
+    char* end = NULL;
+    unsigned long value = strtoul(divisor_str, &end, 10);
+    if (!*divisor_str || *end || value == 0 || value > 256) return 2;
+    divisor = value;
+  }
+  FILE* f = fopen(argv[1], "rb");
+  if (!f) { perror(argv[1]); return 2; }
+  uint32_t h[12];
+  if (fread(h, sizeof(h), 1, f) != 1 || h[0] != 0x31534945 || h[1] != 1 ||
+      h[3] > 503 || h[4] < 6 || h[4] > 100 || (h[5] != 1 && h[5] != 2 && h[5] != 4) ||
+      h[6] != SRSRAN_CP_NORM || h[7] > 1 || h[8] > 3 || h[9] != SRSRAN_FDD || h[10] > 1 || h[11] > 1) {
+    fprintf(stderr, "Invalid/unsupported capture header\n"); return 2;
+  }
+  srsran_use_standard_symbol_size(h[10]);
+  if (h[2] != SRSRAN_SF_LEN_PRB(h[4])) return 2;
+  srsran_cell_t cell = {.id=h[3], .nof_prb=h[4], .nof_ports=h[5], .cp=h[6],
+                        .phich_length=h[7], .phich_resources=h[8], .frame_type=h[9]};
+  if (!srsran_cell_isvalid(&cell)) return 2;
+  cf_t* buffers[SRSRAN_MAX_PORTS] = {srsran_vec_cf_malloc(h[2])};
+  srsran_ue_dl_t dl = {};
+  if (!buffers[0] || srsran_ue_dl_init(&dl, buffers, cell.nof_prb, 1) || srsran_ue_dl_set_cell(&dl, cell)) return 2;
+  srsran_ue_dl_cfg_t cfg = {};
+  cfg.chest_cfg.cfo_estimate_enable = true;
+  cfg.chest_cfg.cfo_estimate_sf_mask = 1023;
+  cfg.chest_cfg.estimator_alg = srsran_chest_dl_str2estimator_alg(argv[2]);
+  cfg.chest_cfg.sync_error_enable = sync_error;
+  srsran_pdsch_cfg_t pdsch = {.rnti=SRSRAN_SIRNTI, .meas_evm_en=true, .max_nof_iterations=iterations};
+  pdsch.csi_enable = getenv("REPLAY_CSI") && !strcmp(getenv("REPLAY_CSI"), "1");
+  if (getenv("REPLAY_MMSE") && !strcmp(getenv("REPLAY_MMSE"), "1")) pdsch.decoder_type = SRSRAN_MIMO_DECODER_MMSE;
+  srsran_softbuffer_rx_t soft[SRSRAN_MAX_CODEWORDS] = {};
+  uint8_t* data[SRSRAN_MAX_CODEWORDS] = {};
+  for (unsigned i=0; i<SRSRAN_MAX_CODEWORDS; i++) {
+    data[i] = srsran_vec_u8_malloc(16000);
+    pdsch.softbuffers.rx[i] = &soft[i];
+    if (!data[i] || srsran_softbuffer_rx_init(&soft[i], cell.nof_prb)) return 2;
+  }
+  bool combine = getenv("REPLAY_COMBINE") && !strcmp(getenv("REPLAY_COMBINE"), "1");
+  e310_si_combiner combiner;
+  if (e310_si_combiner_init(&combiner, cell.nof_prb)) return 2;
+  uint8_t combined_data[16000];
+  uint64_t combined_attempts = 0, combined_errors = 0, combined_recovered = 0;
+  uint64_t records=0, blocks=0, errors=0, no_dci=0, mismatch=0;
+  uint64_t original_blocks=0, original_errors=0;
+  for (;;) {
+    uint32_t tti, expected[3];
+    size_t got=fread(&tti, 1, sizeof(tti), f);
+    if (got==0 && feof(f)) break;
+    if (got!=sizeof(tti) || tti>=10240 || tti%20!=5 ||
+        fread(buffers[0], sizeof(cf_t), h[2], f)!=h[2] ||
+        fread(expected, sizeof(expected), 1, f)!=1) {
+      fprintf(stderr,"Truncated/invalid record at %" PRIu64 "\n",records); return 2;
+    }
+    float cfo_hz = fixed_cfo_hz;
+    if (correction && !strcmp(correction, "cp")) {
+      cf_t sum = 0;
+      unsigned fft = srsran_symbol_sz(cell.nof_prb), offset = 0;
+      for (unsigned symbol = 0; symbol < 14; symbol++) {
+        unsigned cp = SRSRAN_CP_LEN_NORM(symbol % 7, fft);
+        for (unsigned i = cp / 2; i < cp; i++)
+          sum += buffers[0][offset + i + fft] * conjf(buffers[0][offset + i]);
+        offset += cp + fft;
+      }
+      cfo_hz = cargf(sum) * 15000.0f / (2.0f * M_PI);
+    }
+    if (correction) srsran_vec_apply_cfo(buffers[0], -cfo_hz / (1000.0f * h[2]), buffers[0], h[2]);
+    bool ack[SRSRAN_MAX_CODEWORDS] = {};
+    srsran_dl_sf_cfg_t sf = {.tti=tti, .sf_type=SRSRAN_SF_NORM};
+    int n=0;
+    unsigned b=0,e=0,tm_used=0;
+    for (unsigned tm=0; tm<4 && !n; tm++) {
+      cfg.cfg.tm=(srsran_tm_t)tm;
+      if ((tm==SRSRAN_TM1 && cell.nof_ports==1) || (tm>SRSRAN_TM1 && cell.nof_ports>1)) {
+        n=srsran_ue_dl_find_and_decode(&dl, &sf, &cfg, &pdsch, data, ack);
+        tm_used=tm;
+        if (n>0) for(unsigned tb=0;tb<SRSRAN_MAX_CODEWORDS;tb++) if(pdsch.grant.tb[tb].enabled) { b++; e+=!ack[tb]; }
+      }
+    }
+    if (getenv("REPLAY_COMBINE") && n > 0 && pdsch.grant.tb[0].enabled && !pdsch.grant.tb[1].enabled) {
+      int cr = e310_si_combiner_run(&combiner, &dl, &pdsch, tti, combined_data, combine, divisor);
+      if (cr < 0) return 2;
+      combined_attempts++;
+      combined_errors += !cr;
+      combined_recovered += cr && !ack[0];
+      printf("COMBINED_RECORD index=%" PRIu64 " tti=%u crc=%u\n", records, tti, cr);
+    }
+    records++; blocks+=b; errors+=e; no_dci+=n<=0;
+    original_blocks+=expected[1]; original_errors+=expected[2];
+    mismatch+=((uint32_t)n!=expected[0] || b!=expected[1] || e!=expected[2]);
+    printf("REPLAY_RECORD index=%" PRIu64 " tti=%u blocks=%u errors=%u original_blocks=%u original_errors=%u tm=%u rv=%d tbs=%d snr_db=%.3f cfo_norm=%.5f sync0=%.3f sync1=%.3f\n",
+           records-1,tti,b,e,expected[1],expected[2],tm_used+1,
+           n>0?pdsch.grant.tb[0].rv:-1,n>0?pdsch.grant.tb[0].tbs:0,
+           dl.chest_res.snr_db,dl.chest_res.cfo,dl.chest.sync_err[0][0],dl.chest.sync_err[0][1]);
+  }
+  printf("REPLAY_TOTAL estimator=%s sync_error=%u turbo_iterations=%u records=%" PRIu64 " blocks=%" PRIu64 " errors=%" PRIu64
+         " no_dci=%" PRIu64 " original_blocks=%" PRIu64 " original_errors=%" PRIu64 " mismatch_records=%" PRIu64 "\n",
+         argv[2],sync_error,iterations,records,blocks,errors,no_dci,original_blocks,original_errors,mismatch);
+  printf("REPLAY_SETTINGS cfo=%s csi=%u mmse=%u\n", correction ? correction : "none",
+         pdsch.csi_enable, pdsch.decoder_type == SRSRAN_MIMO_DECODER_MMSE);
+  if (getenv("REPLAY_COMBINE")) printf("COMBINED_TOTAL mode=%u llr_divisor=%u attempts=%" PRIu64
+      " errors=%" PRIu64 " recovered=%" PRIu64 "\n", combine, divisor, combined_attempts,
+      combined_errors, combined_recovered);
+  e310_si_combiner_free(&combiner);
+  for(unsigned i=0;i<SRSRAN_MAX_CODEWORDS;i++) { srsran_softbuffer_rx_free(&soft[i]); free(data[i]); }
+  srsran_ue_dl_free(&dl); free(buffers[0]); fclose(f);
+  return records ? 0 : 1;
+}
